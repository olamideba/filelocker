<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.7.2+ ships with every Windows 10 (1803+) and Windows 11 PC,
         so the app is tiny, starts instantly and needs no runtime download. -->
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FileLocker</AssemblyName>
    <RootNamespace>FileLocker</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.2.1</Version>
    <Product>FileLocker</Product>
    <Description>Lock files and folders with a PIN or password.</Description>
    <Copyright>MIT License</Copyright>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the project build with the dotnet SDK on any machine. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
